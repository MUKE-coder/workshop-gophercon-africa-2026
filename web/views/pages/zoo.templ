package pages

import (
	"strconv"
	"strings"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Zoo(exhibits []Exhibit) {
	@layout.Base(layout.BaseProps{
		Title:       "The zoo",
		Description: "Walk through a 3D zoo of the animals in our sightings: zebras, flamingos, macaws, lions and more.",
		Active:      "zoo",
		Scripts:     zooScripts(),
	}) {
		<section class="zoo" data-zoo aria-label="The Tazama zoo, in 3D">
			<canvas class="zoo__canvas" data-zoo-canvas aria-hidden="true"></canvas>
			<div class="zoo__loading" data-zoo-loading>
				@components.Logo(44)
				<p class="zoo__loading-title">Opening the <em class="script">gates</em>…</p>
				<div class="zoo__progress" role="progressbar" aria-label="Loading the zoo" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-zoo-progress>
					<span></span>
				</div>
			</div>
			<p class="zoo__fallback" data-zoo-fallback hidden>
				Your browser can't draw the 3D zoo. Try a recent version of Chrome, Edge, Firefox or Safari.
			</p>
			<div class="zoo__top">
				<div class="zoo__brand">
					<h1>Tazama <em class="script">Zoo</em></h1>
					<p>Drag to look around, scroll to get closer.</p>
				</div>
				<button class="zoo__icon-btn" type="button" data-zoo-fullscreen aria-label="Full screen">
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</button>
			</div>
			<aside class="zoo__panel is-active" data-panel="welcome" aria-labelledby="zoo-welcome">
				<h2 id="zoo-welcome">Welcome to the <em class="script">zoo</em></h2>
				<p>
					Every animal here is one people have really seen and photographed. Take the tour, or pick an
					enclosure below. At each one you can get close, look from above, ride along, or start the show.
				</p>
				<button class="pill pill--lime" type="button" data-go={ exhibits[0].Key }>
					Start the tour
					@components.Arrow()
				</button>
			</aside>
			for i, e := range exhibits {
				@exhibitPanel(e, i, len(exhibits))
			}
			<nav class="zoo__map" aria-label="Enclosures">
				<button type="button" class="zoo__stop" data-go="overview" aria-pressed="true">
					<span class="zoo__stop-dot" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="16" height="16"><path d="M3 10.5 12 4l9 6.5M5.5 9v10h13V9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					</span>
					Overview
				</button>
				for _, e := range exhibits {
					<button type="button" class="zoo__stop" data-go={ e.Key } aria-pressed="false">
						if len(e.Photos) > 0 {
							<img src={ e.Photos[0].Img } alt="" loading="lazy" decoding="async"/>
						} else {
							<span class="zoo__stop-dot" aria-hidden="true">{ string([]rune(e.Animal)[0]) }</span>
						}
						{ e.Animal }
					</button>
				}
			</nav>
			<p class="zoo__ride-hint" data-ride-hint hidden>Riding along. Press Esc or pick an angle to step off.</p>
		</section>
		@templ.JSONScript("zoo-data", exhibits)
	}
}

templ exhibitPanel(e Exhibit, i, total int) {
	<aside class="zoo__panel" data-panel={ e.Key } aria-labelledby={ "zoo-" + e.Key } hidden>
		<div class="zoo__panel-head">
			<p class="zoo__count">{ strconv.Itoa(i+1) } of { strconv.Itoa(total) }</p>
			<div class="zoo__nav">
				<button class="zoo__icon-btn" type="button" data-step="-1" aria-label="Previous enclosure">‹</button>
				<button class="zoo__icon-btn" type="button" data-step="1" aria-label="Next enclosure">›</button>
			</div>
		</div>
		<h2 id={ "zoo-" + e.Key }>{ e.Title } <em class="script">{ e.Script }</em></h2>
		<p class="zoo__animal">{ e.Animal }</p>
		<p class="zoo__fact">{ e.Fact }</p>
		<dl class="zoo__figures">
			<div>
				<dd>{ strconv.Itoa(e.Sightings) }</dd>
				<dt>sightings</dt>
			</div>
			<div>
				<dd>{ strconv.Itoa(e.Countries) }</dd>
				<dt>countries</dt>
			</div>
		</dl>
		if len(e.TopCountries) > 0 {
			<p class="zoo__where">Seen most in { strings.Join(e.TopCountries, ", ") }.</p>
		}
		<div class="zoo__angles" role="group" aria-label="Camera angle">
			<button type="button" data-angle="wide" aria-pressed="true">Wide</button>
			<button type="button" data-angle="close" aria-pressed="false">Close-up</button>
			<button type="button" data-angle="top" aria-pressed="false">From above</button>
			if e.Kind != "screen" {
				<button type="button" data-angle="ride" aria-pressed="false">Ride along</button>
			}
		</div>
		<button class="pill pill--lime zoo__show" type="button" data-show>
			if e.Kind == "screen" {
				Showtime: sound on
			} else {
				Showtime!
			}
			@components.Arrow()
		</button>
		if e.Kind == "screen" {
			<p class="zoo__credit" data-credit={ e.Key }>Looking for footage on Wikimedia Commons…</p>
		}
		if len(e.Photos) > 0 {
			<ul class="zoo__photos">
				for _, p := range e.Photos {
					<li>
						<a href={ templ.SafeURL(p.Link) }>
							<img src={ p.Img } alt={ e.Animal } loading="lazy" decoding="async"/>
							if p.By != "" {
								<span>{ p.By }</span>
							}
						</a>
					</li>
				}
			</ul>
		} else {
			<p class="zoo__where">No photos of these yet. Their sightings are still on the map.</p>
		}
	</aside>
}

templ zooScripts() {
	<script type="module" src="/assets/js/zoo.js"></script>
}
