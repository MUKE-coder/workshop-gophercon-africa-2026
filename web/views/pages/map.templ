package pages

import (
	"strconv"
	"workshop/web/views/layout"
)

templ Map(d MapData) {
	@layout.Base(layout.BaseProps{
		Title:       "Map",
		Description: "Every wildlife sighting on one map.",
		Active:      "map",
		Head:        mapHead(),
		Scripts:     mapScripts(),
	}) {
		<section class="map-page" aria-labelledby="map-title">
			<div class="map-page__bar">
				<h1 id="map-title">Where they were seen</h1>
				<p>{ strconv.Itoa(len(d.Points)) } sightings across { strconv.Itoa(d.Summary.Countries) } countries. Zoom in to split a cluster.</p>
			</div>
			<div class="bigmap-wrap">
				<div class="bigmap" data-bigmap role="region" aria-label="Map of all sightings"></div>
				<button class="tips-toggle" type="button" data-tips-open aria-controls="map-tips">
					<span aria-hidden="true">?</span> How to use the map
				</button>
				<aside id="map-tips" class="tips" data-tips aria-labelledby="tips-title">
					<div class="tips__head">
						<h2 id="tips-title">How to use the <em class="script">map</em></h2>
						<button class="tips__close" type="button" data-tips-close aria-label="Close the tips">×</button>
					</div>
					<ol class="tips__list">
						<li>
							<span class="tips__icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="22" height="22"><circle cx="11" cy="11" r="6" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="M11 8v6M8 11h6M16 16l4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
							</span>
							<div>
								<strong>Zoom in and out</strong>
								<p>Use the + and − buttons, scroll with your mouse wheel, or pinch with two fingers on a phone.</p>
							</div>
						</li>
						<li>
							<span class="tips__icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="22" height="22"><path d="M12 3v18M3 12h18M12 3l-3 3m3-3 3 3M12 21l-3-3m3 3 3-3M3 12l3-3m-3 3 3 3M21 12l-3-3m3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
							</span>
							<div>
								<strong>Move around</strong>
								<p>Click and drag the map, or drag with one finger, to explore other parts of the world.</p>
							</div>
						</li>
						<li>
							<span class="tips__icon tips__icon--cluster" aria-hidden="true">12</span>
							<div>
								<strong>Open a group</strong>
								<p>A green circle with a number is a group of sightings close together. Click it to zoom in and split it up.</p>
							</div>
						</li>
						<li>
							<span class="tips__icon" aria-hidden="true"><span class="pin pin--hibiscus"></span></span>
							<div>
								<strong>See an animal</strong>
								<p>A small coloured dot is one sighting. Click it for a photo, then "Open sighting" for the full story. The colours just tell animals apart.</p>
							</div>
						</li>
					</ol>
					<button class="pill pill--forest" type="button" data-tips-close>Got it, show me the map</button>
				</aside>
			</div>
		</section>
		@templ.JSONScript("map-points", d.Points)
	}
}

templ mapHead() {
	<link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css"/>
	<link rel="stylesheet" href="/assets/vendor/leaflet/MarkerCluster.css"/>
}

templ mapScripts() {
	<script src="/assets/vendor/leaflet/leaflet.js" defer></script>
	<script src="/assets/vendor/leaflet/leaflet.markercluster.js" defer></script>
	<script src="/assets/js/map.js" defer></script>
}
