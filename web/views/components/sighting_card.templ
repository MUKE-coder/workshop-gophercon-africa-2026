package components

import (
	"fmt"
	"workshop/internal/domain/sighting"
)

// SightingCard is one card in the sightings grid. The whole card links to
// the sighting's own page, and its photo flies there when clicked.
templ SightingCard(s sighting.Sighting) {
	{{ name := DisplayName(s.Species) }}
	<article class="card">
		<a class="card__link" href={ templ.SafeURL("/sightings/" + s.ID.String()) }>
			<figure class="card__photo">
				if img, ok := LeadImage(s); ok {
					<img src={ Sized(img.URL, "medium") } alt={ AltText(img, name) } loading="lazy" decoding="async" style={ TransitionName(s.ID.String()) }/>
					if n := len(Images(s.Media)); n > 1 {
						<span class="card__count">{ n } photos</span>
					}
				} else {
					<span class="card__placeholder" aria-hidden="true">{ string([]rune(name)[0]) }</span>
				}
			</figure>
			<div class="card__body">
				<div class="card__title">
					<h3>{ name }</h3>
					if HasWeather(s.Weather) {
						<span class="card__weather" title={ s.Weather.Condition.Description }>
							{ WeatherIcon(s.Weather.Condition.Code) } { tempShort(s) }
						</span>
					}
				</div>
				<p class="card__meta">{ ShortPlace(s.Location) }</p>
				<p class="card__meta card__meta--soft">
					<time datetime={ s.HappenedAt.Format("2006-01-02") }>{ s.HappenedAt.Format("2 January 2006") }</time>
					if s.RecordedBy != "" {
						<span class="card__by">by { s.RecordedBy }</span>
					}
				</p>
			</div>
		</a>
	</article>
}

func tempShort(s sighting.Sighting) string {
	return fmt.Sprintf("%.0f°", s.Weather.Temperature.Actual)
}
