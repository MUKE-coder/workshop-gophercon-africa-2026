package layout

import "workshop/web/views/components"

type BaseProps struct {
	Title       string
	Description string
	// Active is the nav item to mark as the current page: "home", "map" or "stats".
	Active string
	// Head and Scripts let a page add its own stylesheets and scripts.
	Head    templ.Component
	Scripts templ.Component
}

const siteName = "Tazama"

func pageTitle(t string) string {
	if t == "" || t == siteName {
		return siteName + ": wildlife sightings"
	}
	return t + " | " + siteName
}

func description(d string) string {
	if d == "" {
		return "Wildlife sightings from around the world, recorded by the people who were there."
	}
	return d
}

templ Base(props BaseProps) {
	<!DOCTYPE html>
	<html lang="en-GB">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ pageTitle(props.Title) }</title>
			<meta name="description" content={ description(props.Description) }/>
			<meta name="theme-color" content="#1F4D3A"/>
			<meta name="view-transition" content="same-origin"/>
			<meta property="og:title" content={ pageTitle(props.Title) }/>
			<meta property="og:description" content={ description(props.Description) }/>
			<meta property="og:type" content="website"/>
			<meta property="og:image" content="/assets/img/og.svg"/>
			<meta name="twitter:card" content="summary_large_image"/>
			<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml"/>
			<link rel="preload" href="/assets/vendor/fonts/geist.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/assets/vendor/fonts/kalam.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/assets/css/app.css"/>
			<script type="importmap">
				{ "imports": { "three": "/assets/vendor/three.module.min.js", "three/addons/": "/assets/vendor/three/" } }
			</script>
			<script>
				// Runs before first paint: restores the theme, and opens each new page
				// as a circle bursting out from wherever the visitor clicked.
				(function () {
					try {
						var t = localStorage.getItem("tazama-theme");
						if (t) document.documentElement.dataset.theme = t;
					} catch (e) {}

					window.addEventListener("pagereveal", function (e) {
						if (!e.viewTransition) return;
						var p = null;
						try {
							p = JSON.parse(sessionStorage.getItem("tazama-click") || "null");
							sessionStorage.removeItem("tazama-click");
						} catch (err) {}
						var x = p ? p.x : innerWidth / 2;
						var y = p ? p.y : innerHeight / 2;
						var r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
						e.viewTransition.ready.then(function () {
							document.documentElement.animate(
								{ clipPath: ["circle(0px at " + x + "px " + y + "px)", "circle(" + r + "px at " + x + "px " + y + "px)"] },
								{ duration: 700, easing: "cubic-bezier(0.7, 0, 0.2, 1)", pseudoElement: "::view-transition-new(root)" }
							);
						});
					});
				})();
			</script>
			if props.Head != nil {
				@props.Head
			}
		</head>
		<body>
			<a class="skip" href="#main">Skip to content</a>
			<header class="site-header">
				<div class="site-header__inner">
					<a class="brand" href="/" aria-label="Tazama home">
						@components.Logo(28)
						<span class="brand__name">Tazama</span>
					</a>
					<nav class="nav" aria-label="Main">
						<a href="/#sightings" aria-current={ current(props.Active, "home") }>Sightings</a>
						<a href="/#compare">Compare</a>
						<a href="/zoo" aria-current={ current(props.Active, "zoo") }>Zoo</a>
						<a href="/map" aria-current={ current(props.Active, "map") }>Map</a>
						<a href="/stats" aria-current={ current(props.Active, "stats") }>Numbers</a>
					</nav>
					<div class="site-header__end">
						<button class="theme-toggle" type="button" aria-label="Switch between light and dark" data-theme-toggle>
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
								<circle class="sun" cx="12" cy="12" r="5" fill="currentColor"></circle>
								<path class="moon" d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="currentColor"></path>
							</svg>
						</button>
						<a class="pill pill--lime pill--small" href="/#compare">
							Compare countries
							@components.Arrow()
						</a>
					</div>
				</div>
			</header>
			<main id="main">
				{ children... }
			</main>
			<footer class="site-footer">
				<div class="site-footer__inner">
					<div class="site-footer__brand">
						@components.Logo(24)
						<p><strong>Tazama</strong> means “look” in Swahili.</p>
					</div>
					<p>
						Sightings from <a href="https://www.gbif.org" rel="noopener">GBIF</a>, weather from
						<a href="https://open-meteo.com" rel="noopener">Open-Meteo</a>. Photos belong to the people
						credited with them. 3D birds from the <a href="https://threejs.org/examples/#webgl_lights_hemisphere" rel="noopener">three.js examples</a>.
					</p>
					<p>Built in Go with sqlc and templ at GopherCon Africa 2026, Nairobi.</p>
				</div>
			</footer>
			<div class="lightbox" data-lightbox-dialog hidden>
				<button class="lightbox__close" type="button" aria-label="Close photo">×</button>
				<button class="lightbox__nav lightbox__nav--prev" type="button" aria-label="Previous photo">‹</button>
				<figure>
					<img alt=""/>
					<figcaption></figcaption>
				</figure>
				<button class="lightbox__nav lightbox__nav--next" type="button" aria-label="Next photo">›</button>
			</div>
			<script src="/assets/vendor/gsap.min.js" defer></script>
			<script src="/assets/vendor/ScrollTrigger.min.js" defer></script>
			<script src="/assets/js/app.js" defer></script>
			if props.Scripts != nil {
				@props.Scripts
			}
		</body>
	</html>
}

func current(active, item string) string {
	if active == item {
		return "page"
	}
	return ""
}
